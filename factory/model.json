{
  "summary": {
    "text": "Spring PetClinic is a server-rendered Spring Boot 4 / Spring MVC web app for a veterinary clinic. Staff find, create and edit pet owners, add and edit their pets, book, change and cancel visits for a pet, and browse the list of vets and their specialties (as HTML or as a JSON/XML resource). Data is stored with Spring Data JPA in H2 by default (MySQL and PostgreSQL via profiles); pages are Thymeleaf templates with Bootstrap styling and i18n message bundles. The vet list is cached with JCache/Caffeine. The repo also carries factory/cartographer tooling (.fence, .cartographer, skills, workflows) that is not part of the app.",
    "sources": [
      "pom.xml",
      "build.gradle",
      "src/main/resources/application.properties",
      "src/main/java/org/springframework/samples/petclinic/owner/OwnerController.java"
    ]
  },
