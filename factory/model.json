  "flows": [
    {
      "name": "find-owner",
      "steps": [
        {
          "text": "GET /owners/find shows the search form.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/OwnerController.java"
          ]
        },
        {
          "text": "GET /owners?lastName=... strips the name and queries findByLastNameStartingWith with page size 5.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/OwnerController.java"
          ]
        },
        {
          "text": "Out-of-range page redirects to page 1; no match rejects lastName 'notFound' and re-shows the form; exactly one match redirects to /owners/{id}; several render the paginated list.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/OwnerController.java"
          ]
        },
        {
          "text": "Templates render the form, list or details.",
          "area": "web-ui",
          "files": [
            "src/main/resources/templates/owners/ownersList.html"
          ]
        }
      ]
    },
    {
      "name": "create-or-edit-owner",
      "steps": [
        {
          "text": "GET /owners/new or /owners/{id}/edit shows the form; the id fields are disallowed from binding.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/OwnerController.java"
          ]
        },
        {
          "text": "POST validates the Owner; errors re-show the form with an error flash.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/OwnerController.java"
          ]
        },
        {
          "text": "On edit, a form id that differs from the URL id is rejected with a redirect back to the edit form.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/OwnerController.java"
          ]
        },
        {
          "text": "The owner is saved and the user is redirected to /owners/{id} with a flash message.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/OwnerController.java"
          ]
        }
      ]
    },
    {
      "name": "add-or-edit-pet",
      "steps": [
        {
          "text": "Model attributes load the owner, the pet types list and (for edit) the pet from the owner.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/PetController.java"
          ]
        },
        {
          "text": "POST /owners/{id}/pets/new or /pets/{petId}/edit validates with PetValidator, rejects a duplicate name for the owner and a birth date in the future.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/PetController.java",
            "src/main/java/org/springframework/samples/petclinic/owner/PetValidator.java"
          ]
        },
        {
          "text": "The pet is added to or updated on the owner and saved with saveAndFlush; a unique_owner_pet_name violation becomes a 'duplicate' field error.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/PetController.java",
            "src/main/resources/db/h2/schema.sql"
          ]
        },
        {
          "text": "Redirect to the owner page with a flash message.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/PetController.java"
          ]
        }
      ]
    },
    {
      "name": "book-visit",
      "steps": [
        {
          "text": "loadPetWithVisit loads owner and pet (IllegalArgumentException if missing), and attaches a fresh Visit dated tomorrow to the pet.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/VisitController.java"
          ]
        },
        {
          "text": "POST /owners/{o}/pets/{p}/visits/new rejects a date that is not after today and validates description.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/VisitController.java",
            "src/main/java/org/springframework/samples/petclinic/owner/Visit.java"
          ]
        },
        {
          "text": "owner.addVisit(petId, visit) and owners.save persist the visit through cascade; redirect with 'Your visit has been booked'.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/VisitController.java",
            "src/main/java/org/springframework/samples/petclinic/owner/Owner.java"
          ]
        }
      ]
    },
    {
      "name": "change-or-cancel-visit",
      "steps": [
        {
          "text": "Owner, pet and visit are looked up; missing ones give 404, past visits give 400.",
          "area": "owners-pets-visits",
          "files": [
            "src/main/java/org/springframework/samples/petclinic/owner/VisitChangeController.java"
