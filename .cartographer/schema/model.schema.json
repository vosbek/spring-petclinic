{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vosbek/codebase-cartographer/model.schema.json",
  "title": "Cartographer model",
  "type": "object",
  "required": [
    "schemaVersion",
    "repo",
    "generated",
    "layers",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repo": {
      "type": "object",
      "required": [
        "name",
        "summary"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "blobUrl": {
          "type": "string",
          "description": "Link template with {commit}, {path}, {line}"
        }
      }
    },
    "generated": {
      "type": "object",
      "required": [
        "at",
        "commit"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "commit": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "by": {
          "type": "string"
        }
      }
    },
    "readingPath": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "target"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "pattern": "^(component|flow|snippet|risk|decision|file|view):.+"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "layer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "service",
              "module",
              "library",
              "job",
              "ui",
              "adapter",
              "datastore",
              "external",
              "config",
              "test"
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tech": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "keyFiles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "name"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "http",
                    "soap",
                    "grpc",
                    "event",
                    "batch",
                    "cli",
                    "ui",
                    "library"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                }
              }
            }
          },
          "snippets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "calls",
              "reads",
              "writes",
              "publishes",
              "consumes",
              "depends"
            ]
          },
          "label": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "component",
                "action"
              ],
              "properties": {
                "component": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "snippet": {
                  "type": "string"
                },
                "evidence": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/evidence"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/evidence"
                      },
                      "minItems": 1
                    }
                  ],
                  "description": "One evidence object or a list; the viewer shows the first."
                }
              }
            }
          }
        }
      }
    },
    "snippets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "path",
          "start",
          "end",
          "code"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "entry-point",
              "core-logic",
              "invariant",
              "gotcha",
              "pattern",
              "integration",
              "config"
            ]
          },
          "component": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "minimum": 1
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "language": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "annotations": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": [
                "line",
                "note"
              ],
              "properties": {
                "line": {
                  "type": "integer"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "pin": {
            "type": "object",
            "properties": {
              "commit": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "documented",
              "inferred"
            ]
          },
          "context": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "consequences": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "definition"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "q"
        ],
        "properties": {
          "q": {
            "type": "string"
          },
          "context": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        },
        "expect": {
          "type": "string",
          "description": "Optional text the cited line (or line..end) must contain; check.py fails when it does not, which catches off-by-N line numbers."
        }
      },
      "additionalProperties": false
    }
  }
}
