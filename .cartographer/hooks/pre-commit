#!/bin/sh
# Cartographer guardrails on what is about to be committed. Bypass once with: git commit --no-verify
root="$(git rev-parse --show-toplevel)"
py="$(command -v python3 || command -v python || echo py)"
CARTOGRAPHER_SOURCE=pre-commit exec "$py" "$root/.cartographer/bin/guard.py" --repo "$root" --staged --quiet
